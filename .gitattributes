# 统一换行符：仓库内一律使用 LF，避免 Windows 下 core.autocrlf 产生的大量警告
* text=auto

# 文本类文件固定为 LF
*.java       text eol=lf
*.xml        text eol=lf
*.properties text eol=lf
*.md         text eol=lf
*.sql        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# 二进制文件不参与换行符处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.xls   binary
*.xlsx  binary
*.docx  binary
*.class binary
